---
/**
 * Resume — 05-pages/resume.md (APROBADA).
 *
 * Sirve /resume y /es/resume. El botón de descarga es lo primero tras el <h1>.
 *
 * El PDF es un archivo estático mantenido por el usuario (Q-G). Su peso se lee
 * del archivo AL COMPILAR, y si falta el build falla: nunca se publica un enlace
 * roto ni un peso escrito a mano que se desincronice.
 */
import { statSync } from 'node:fs';
import { join } from 'node:path';

import SkillsGrid from '@/components/sections/SkillsGrid.astro';
import Timeline from '@/components/sections/Timeline.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { EDUCATION } from '@/content/education';
import { LANGUAGES_SPOKEN } from '@/content/languages';
import { getExperience } from '@/content/queries';
import { SOCIAL_LINKS } from '@/content/social';
import { localizePath, useTranslations, type Lang } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatFileSize } from '@/lib/format';

interface Props {
  lang: Lang;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const fileName = `daxho-resume-${lang}.pdf`;
const filePath = join(process.cwd(), 'public', 'resume', fileName);
let size: number;
try {
  size = statSync(filePath).size;
} catch {
  throw new Error(
    `Falta public/resume/${fileName}: el botón de descarga no puede apuntar a un archivo que no existe (05-pages/resume.md).`,
  );
}
const downloadMeta = t('resume.downloadMeta')
  .replace('{lang}', t('resume.fileLang'))
  .replace('{size}', formatFileSize(size, lang));

const experience = await getExperience(lang);
---

<BaseLayout title={t('resume.title')}>
  <Container class="flex flex-col gap-16 py-16">
    {/* 1. Cabecera: el botón de descarga es lo primero tras el <h1>. */}
    <header class="flex flex-col items-start gap-6">
      <SectionHeading text={t('nav.resume')} as="h1" class="text-4xl" />
      <Button
        href={`/resume/${fileName}`}
        download={fileName}
        hreflang={lang}
        class="print-hidden"
        data-resume-download
      >
        {t('resume.download')}
        <span class="font-normal opacity-80">({downloadMeta})</span>
      </Button>
    </header>

    {/* 2. Datos de contacto: sin correo publicado (decisión del usuario). */}
    <section class="flex flex-col gap-4">
      <SectionHeading text={t('resume.contact')} as="h2" />
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm" data-resume-contact>
        {
          SOCIAL_LINKS.map((item) => (
            <li>
              <a
                class="text-fg-secondary hover:text-accent-text transition-colors"
                href={item.href}
                data-placeholder={item.draft ? 'fase-10' : undefined}
              >
                {item.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="text-fg-secondary hover:text-accent-text transition-colors"
            href={localizePath('/contact', lang)}
          >
            {t('resume.contactForm')}
          </a>
        </li>
      </ul>
    </section>

    {/* 3. Perfil profesional */}
    <section class="flex flex-col gap-4">
      <SectionHeading text={t('resume.profile')} as="h2" />
      <p class="text-fg-secondary max-w-(--container-reading) leading-relaxed">
        {t('resume.profile.text')}
      </p>
    </section>

    {/* 4. Experiencia: misma colección que /about. */}
    <section class="flex flex-col gap-8">
      <SectionHeading text={t('about.experience')} as="h2" />
      <Timeline lang={lang} entries={experience} />
    </section>

    {/* 5. Skills */}
    <section class="flex flex-col gap-8">
      <SectionHeading text={t('about.skills')} as="h2" />
      <SkillsGrid lang={lang} />
    </section>

    {/* 6. Formación */}
    <section class="flex flex-col gap-4">
      <SectionHeading text={t('resume.education')} as="h2" />
      <ul class="flex flex-col gap-3" data-resume-education>
        {
          EDUCATION.map((entry) => (
            <li class="flex flex-col gap-1">
              <span class="text-fg-primary">{entry.degree[lang]}</span>
              <span class="text-fg-secondary font-mono text-xs">
                {entry.institution} · {entry.startYear} –{' '}
                {entry.endYear ?? t('resume.inProgress')}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* 7. Idiomas */}
    <section class="flex flex-col gap-4">
      <SectionHeading text={t('resume.languages')} as="h2" />
      <dl class="grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2" data-resume-languages>
        {
          LANGUAGES_SPOKEN.map((entry) => (
            <>
              <dt class="text-fg-primary">{entry.name[lang]}</dt>
              <dd class="text-fg-secondary">{entry.level[lang]}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </Container>
</BaseLayout>
