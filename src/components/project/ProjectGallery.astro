---
/**
 * Galería del detalle de proyecto — 05-pages/project-detail.md (Q-E).
 *
 * Capturas EN LÍNEA, cada una envuelta en un <a> hacia la imagen a tamaño
 * completo. **Sin lightbox**: cero JavaScript, sin foco atrapado que gestionar,
 * y funciona igual sin JS.
 *
 * Sin CLS: <Image> emite width y height reales y el contenedor fija el ratio.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: readonly { image: ImageMetadata; alt: string; caption?: string | undefined }[];
}

const { items }: Props = Astro.props;
---

<ul class="grid gap-8 md:grid-cols-2">
  {
    items.map((item) => (
      <li>
        <figure class="flex flex-col gap-3">
          <a
            href={item.image.src}
            class="border-subtle hover:border-accent-border block overflow-hidden rounded-md border transition-colors"
          >
            {/* El alt viene del contenido, nunca autogenerado (project-detail.md). */}
            <Image
              src={item.image}
              alt={item.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-video h-auto w-full object-cover"
            />
          </a>
          {item.caption && (
            <figcaption class="text-fg-secondary font-mono text-xs">{item.caption}</figcaption>
          )}
        </figure>
      </li>
    ))
  }
</ul>
