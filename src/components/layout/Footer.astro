---
/**
 * Footer — 06-components.md.
 *
 * Los enlaces a redes son PLACEHOLDER hasta la fase 10 (Q36 resuelta): el
 * usuario aporta las URLs reales entonces. Se marcan visiblemente para que no
 * se cuelen en producción por olvido.
 */
import Container from '@/components/ui/Container.astro';
import { SOCIAL_LINKS } from '@/content/social';
import { localizePath, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="border-subtle mt-24 border-t py-10">
  <Container class="flex flex-wrap items-center justify-between gap-4">
    <p class="text-fg-muted font-mono text-xs">
      © {year}
      <a class="hover:text-accent-text" href={localizePath('/', lang)}>daxho</a>
      {' · '}{t('footer.rights')}
      {
        /* ADR-0015: la analítica no usa cookies, y decirlo en una línea evita
          el banner entero. */
      }
      <span class="block sm:inline">
        <span class="hidden sm:inline">{' · '}</span>{t('footer.cookies')}
      </span>
    </p>

    <ul class="flex items-center gap-4" aria-label={t('footer.social')}>
      {
        SOCIAL_LINKS.map((item) => (
          <li>
            <a
              class="text-fg-secondary hover:text-accent-text font-mono text-xs transition-colors"
              href={item.href}
              data-placeholder={item.draft ? 'fase-10' : undefined}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</footer>
