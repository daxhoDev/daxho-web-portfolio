---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  /** `content` = 1200px general · `reading` = 720px para texto largo (máx. 65ch) */
  width?: 'content' | 'reading';
}

const { width = 'content', class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-4 md:px-6 lg:px-12',
    width === 'content' ? 'max-w-(--container-content)' : 'max-w-(--container-reading)',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
