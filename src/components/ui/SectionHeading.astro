---
/**
 * Encabezado de sección con tecleo disparado (ADR-0014).
 *
 * Sustituye al glitch desde 2026-09-14 (ver DEVIATIONS.md). El tecleo arranca
 * al entrar en pantalla y ocurre UNA sola vez: no se repite con hover ni con
 * foco. Un encabezado que se reescribe al pasar el ratón se lee como un fallo
 * de render, no como una intención de diseño; el foco se marca con el outline
 * de siempre, que es lo que pide WCAG.
 *
 * El cursor es efímero: acompaña al tecleo y se apaga con la última letra.
 */
import TypingText from '@/components/ui/TypingText.astro';

interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { text, as: Tag = 'h2', class: className }: Props = Astro.props;
---

<Tag class:list={['text-3xl', className]}>
  <TypingText text={text} trigger="viewport" caret="transient" />
</Tag>
