---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  label: string;
}

const { label, class: className, ...rest } = Astro.props;
---

<span
  class:list={[
    // Radio 0: los elementos técnicos son angulosos (02-design-system.md §5)
    'border-subtle text-fg-secondary inline-flex items-center gap-1.5 border px-2 py-1',
    'font-mono text-xs rounded-none',
    className,
  ]}
  {...rest}
>
  <slot name="icon" />
  {label}
</span>
