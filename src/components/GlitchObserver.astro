---
/**
 * Glitch con PowerGlitch — ADR-0014 (mecanismo cambiado por decisión del
 * usuario, ver DEVIATIONS.md).
 *
 * Sigue siendo DISPARADO, no en bucle: `playMode: 'manual'` y nosotros
 * decidimos cuándo. Se ejecuta una vez al entrar en viewport y mientras haya
 * hover.
 *
 * PowerGlitch reorganiza el DOM: envuelve el elemento en dos contenedores y lo
 * clona N veces para las rebanadas. Por eso:
 *   - los clones se marcan aria-hidden, o un lector de pantalla leería el
 *     texto una vez por capa;
 *   - se tiñe cada capa con un rojo distinto de la rampa Blood desde CSS.
 */
---

<script>
  import { PowerGlitch } from 'powerglitch';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
  const GLITCH_MS = 520;

  function initGlitch() {
    // Regla transversal de ADR-0014: bajo reduced-motion no se inicializa
    // siquiera. Así tampoco se paga el coste de reorganizar el DOM.
    if (REDUCED.matches) return;
    if (document.documentElement.getAttribute('data-reduce-motion') === 'true') return;

    const targets = document.querySelectorAll<HTMLElement>('.glitch:not([data-glitch-ready])');
    if (targets.length === 0) return;

    targets.forEach((target) => {
      target.setAttribute('data-glitch-ready', '');

      const { containers, startGlitch, stopGlitch } = PowerGlitch.glitch(target, {
        playMode: 'manual',
        createContainers: true,
        hideOverflow: false,
        timing: { duration: GLITCH_MS, iterations: 1 },
        glitchTimeSpan: false,
        shake: { velocity: 18, amplitudeX: 0.12, amplitudeY: 0.06 },
        slice: {
          count: 6,
          velocity: 18,
          minHeight: 0.03,
          maxHeight: 0.22,
          hueRotate: false,
        },
        pulse: false,
      });

      const container = containers[0];
      if (!container) return;

      container.classList.add('glitch-container');

      // Los clones duplican el texto: fuera del árbol de accesibilidad.
      const layerContainer = container.firstElementChild;
      if (layerContainer) {
        Array.from(layerContainer.children).forEach((child, index) => {
          if (index > 0) child.setAttribute('aria-hidden', 'true');
        });
      }

      let timer: number | undefined;
      const fire = () => {
        window.clearTimeout(timer);
        container.classList.add('is-warping');
        startGlitch();
        timer = window.setTimeout(() => {
          stopGlitch();
          container.classList.remove('is-warping');
        }, GLITCH_MS);
      };

      container.addEventListener('mouseenter', fire);
      container.addEventListener('focusin', fire);

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              fire();
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.35 },
        );
        observer.observe(container);
      }
    });
  }

  initGlitch();
  document.addEventListener('astro:page-load', initGlitch);
</script>
