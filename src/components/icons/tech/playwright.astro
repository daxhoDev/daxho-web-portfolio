---
/**
 * Playwright — ÚNICO icono dibujado a mano del catálogo.
 *
 * Simple Icons no incluye su marca, así que se dibuja aquí. Se hace como
 * SILUETA SÓLIDA, no lineart, para que case con los otros 24 (DEVIATIONS.md):
 * una máscara de teatro, que es el motivo de su logotipo.
 *
 * `fill-rule="evenodd"` recorta los ojos del relleno exterior.
 */
interface Props {
  size?: number;
  title?: string;
  class?: string;
}

const { size = 24, title, class: className }: Props = Astro.props;
const decorative = !title;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title}
  class:list={['shrink-0', className]}
>
  <path
    fill-rule="evenodd"
    d="M12 2c4.6 0 8 3.9 8 9 0 5.4-3.7 11-8 11S4 16.4 4 11c0-5.1 3.4-9 8-9Zm-2.6 7.6c-.9 0-1.6.9-1.6 2s.7 2 1.6 2 1.6-.9 1.6-2-.7-2-1.6-2Zm5.2 0c-.9 0-1.6.9-1.6 2s.7 2 1.6 2 1.6-.9 1.6-2-.7-2-1.6-2ZM8.2 16.8c1 .9 2.3 1.4 3.8 1.4s2.8-.5 3.8-1.4c-1 .4-2.4.6-3.8.6s-2.8-.2-3.8-.6Z"
  ></path>
</svg>
