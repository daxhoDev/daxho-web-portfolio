---
/**
 * Icono de marca desde el paquete `simple-icons`.
 *
 * Los trazados son los OFICIALES de cada marca, así que la forma es correcta
 * por construcción: no hay riesgo de que un elefante no parezca un elefante.
 *
 * Contrapartida: son SILUETAS SÓLIDAS, no lineart. La comparación con los
 * iconos dibujados a mano está en /styleguide, sección 06, pendiente de que el
 * usuario elija estilo.
 *
 * Se importa solo en el frontmatter, es decir en el build: el paquete no llega
 * al navegador y no pesa nada en el cliente.
 */
import * as simpleIcons from 'simple-icons';

interface Props {
  /** Slug de Simple Icons, p. ej. "postgresql". */
  slug: string;
  size?: number;
  title?: string;
  /** `solid` = silueta rellena · `outline` = contorno de esa silueta. */
  variant?: 'solid' | 'outline';
  class?: string;
}

const { slug, size = 24, title, variant = 'solid', class: className }: Props = Astro.props;

const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
const icon = (simpleIcons as unknown as Record<string, { path: string; title: string }>)[key];

// Falla el BUILD si la tecnología no existe en la librería, en lugar de
// renderizar un hueco silencioso (04-content-model.md).
if (!icon) {
  throw new Error(
    `Simple Icons no contiene "${slug}" (buscado como ${key}). Hay que dibujarlo a mano.`,
  );
}

const decorative = !title;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={variant === 'solid' ? 'currentColor' : 'none'}
  stroke={variant === 'outline' ? 'currentColor' : 'none'}
  stroke-width={variant === 'outline' ? 0.75 : undefined}
  stroke-linejoin={variant === 'outline' ? 'round' : undefined}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title ?? undefined}
  class:list={['shrink-0', className]}
>
  <path d={icon.path} />
</svg>
