---
/**
 * Contact — esqueleto de la FASE 2 (13-roadmap.md).
 *
 * La página está VACÍA a propósito: el entregable de esta fase es el sitio
 * navegable en dos idiomas, no su contenido. Lo rellena la fase 7.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const title = t('nav.contact');
---

<BaseLayout title={`${title} — Daxho`}>
  <Container class="py-16">
    <SectionHeading text={title} as="h1" class="mb-6" />
    <p class="text-fg-secondary font-mono text-sm">
      {/* Marcador visible: si esto llega a producción, se ve. */}
      [la fase 7]
    </p>
  </Container>
</BaseLayout>
